# Asistto by Humanio - variables de entorno
# Copia este archivo a .env y rellena tus valores reales.
# Nunca publiques tu .env.

# --- Easypanel / App ---
PORT=8000
PUBLIC_BASE_URL=https://bot.humanio.digital

# --- GitHub ---
GITHUB_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
# Nombres recomendados para Easypanel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_REDIRECT_URI=https://bot.humanio.digital/admin/meta/oauth/callback

# Aliases legacy tambien soportados por la app:
# WHATSAPP_API_TOKEN=
# VERIFY_TOKEN=
# WEBHOOK_DOMAIN=

# --- OpenAI ---
# Para OpenAI directo, deja OPENAI_BASE_URL vacio y usa un modelo OpenAI.
# Para OpenRouter, pega tu API key de OpenRouter aqui y usa OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_TOKENS=450
EMBEDDING_DIMENSIONS=1536
OPENROUTER_SITE_URL=https://bot.humanio.digital
OPENROUTER_APP_NAME=Asistto by Humanio

# --- Asistente de prompts en el panel admin ---
# Opcional. Si lo dejas vacio, usa OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL.
# Proveedores: openai_compatible, openrouter, anthropic.
PROMPT_ASSISTANT_PROVIDER=openai_compatible
PROMPT_ASSISTANT_API_KEY=
PROMPT_ASSISTANT_BASE_URL=
PROMPT_ASSISTANT_MODEL=
PROMPT_ASSISTANT_MAX_TOKENS=2500
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Postgres ---
# Usa la URL interna del servicio Postgres creado en Easypanel.
DATABASE_URL=

# --- Bot ---
DEFAULT_BOT_SLUG=asistto
# Multi-tenant SaaS uses Postgres bot records and encrypted per-bot integrations.
# Global WhatsApp/Google values are only for the default Asistto demo bot.
HISTORY_WINDOW=10
MAX_PROMPT_TOKENS=6000
MAX_USER_MESSAGE_CHARS=4000
HISTORY_TTL_DAYS=30

# URL opcional para leads calificados: agenda, formulario, landing, checkout, etc.
QUALIFIED_CTA_URL=

# En false, el bot solo responde a mensajes entrantes.
ENABLE_FOLLOW_UPS=false
FOLLOW_UP_MINUTES=10

# Token para POST /reload y /maintenance/reset-contact.
RELOAD_TOKEN=

# --- Google Calendar / agenda ---
# Valores reales solo en Easypanel o .env local, nunca en GitHub.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Chihuahua
GOOGLE_APPOINTMENT_DURATION_MINUTES=30
GOOGLE_APPOINTMENT_BUFFER_MINUTES=0
GOOGLE_APPOINTMENT_SUMMARY_PREFIX=Llamada Asistto
GOOGLE_APPOINTMENT_LOCATION=

# --- Panel admin /admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Obligatorio en produccion. Debe ser estable; si cambia no se podran descifrar
# secretos guardados de integraciones por bot.
INTEGRATION_SECRET_KEY=

# --- SaaS limits ---
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
CONTACTS_UPLOAD_MAX_BYTES=5242880
CAMPAIGN_MAX_RECIPIENTS=500

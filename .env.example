NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://bot.tudominio.com

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=pon-un-token-largo-para-meta
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v25.0

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=https://bot.tudominio.com
OPENROUTER_APP_NAME=Asistto WhatsApp Agent

# Postgres creado en Easypanel
DATABASE_URL=postgres://postgres:password@postgres:5432/asistto

# Tenant demo inicial
DEFAULT_TENANT_NAME=Consultorio Dental Mangoex
DEFAULT_TENANT_TIMEZONE=America/Mazatlan
DEFAULT_TENANT_APPOINTMENT_MINUTES=60
DEFAULT_TENANT_SERVICES=Limpieza dental, Valoracion, Ortodoncia, Blanqueamiento, Emergencia dental

# WhatsApp Bot Template - variables de entorno
# Copia este archivo a .env y rellena tus valores reales.
# Nunca publiques tu .env.

# --- Easypanel / App ---
PORT=8000
PUBLIC_BASE_URL=https://bot.humanio.digital

# --- GitHub ---
GITHUB_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
# Nombres recomendados para Easypanel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=

# Aliases legacy tambien soportados por la app:
# WHATSAPP_API_TOKEN=
# VERIFY_TOKEN=
# WEBHOOK_DOMAIN=

# --- OpenAI ---
# Para OpenAI directo, deja OPENAI_BASE_URL vacio y usa un modelo OpenAI.
# Para OpenRouter, pega tu API key de OpenRouter aqui y usa OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_TOKENS=450
OPENROUTER_SITE_URL=https://bot.humanio.digital
OPENROUTER_APP_NAME=Humanio WhatsApp Bot

# --- Postgres ---
# Usa la URL interna del servicio Postgres creado en Easypanel.
DATABASE_URL=

# --- Bot ---
DEFAULT_BOT_SLUG=asistto
# Future multi-bot support uses Postgres bot records. These global values remain
# the fallback/default bot configuration for Asistto.
HISTORY_WINDOW=10
MAX_PROMPT_TOKENS=6000
MAX_USER_MESSAGE_CHARS=4000
HISTORY_TTL_DAYS=30

# URL opcional para leads calificados: agenda, formulario, landing, checkout, etc.
QUALIFIED_CTA_URL=

# En false, el bot solo responde a mensajes entrantes.
ENABLE_FOLLOW_UPS=false
FOLLOW_UP_MINUTES=10

# Token para POST /reload y /maintenance/reset-contact.
RELOAD_TOKEN=

# --- Google Calendar / agenda ---
# Valores reales solo en Easypanel o .env local, nunca en GitHub.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Chihuahua
GOOGLE_APPOINTMENT_DURATION_MINUTES=30
GOOGLE_APPOINTMENT_BUFFER_MINUTES=0
GOOGLE_APPOINTMENT_SUMMARY_PREFIX=Llamada Asistto
GOOGLE_APPOINTMENT_LOCATION=

# --- Panel admin /admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
